# Contoh konfigurasi. Salin ke .env lalu isi dengan nilai sebenarnya.
# JANGAN pernah commit .env yang sudah terisi.

# --- Wajib -------------------------------------------------------------
# Koneksi PostgreSQL (Supabase). Ambil dari Project Settings > Database.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require

# Kunci penanda tangan sesi. Minimal 32 karakter, acak.
# Buat dengan: python -c "import secrets;print(secrets.token_hex(48))"
SECRET_KEY=

# Kata sandi owner pertama (dipakai hanya saat tabel owner masih kosong).
# Minimal 12 karakter.
OWNER_PASSWORD=

# --- Opsional ----------------------------------------------------------
# Asal aplikasi yang sah (dipisah tanda koma bila lebih dari satu).
# Kosongkan jika aplikasi hanya diakses lewat satu domain.
APP_ORIGIN=https://rofi-jaya.fly.dev

# --- Notifikasi WhatsApp (Fonnte) -------------------------------------
# Token Fonnte dari https://fonnte.com (menu Device > Token).
# Kosongkan dulu kalau belum punya; notifikasi otomatis otomatis dilewati.
FONNTE_TOKEN=

# Cara mengirim foto ke WhatsApp. Fonnte hanya menerima satu lampiran
# per permintaan, jadi beberapa foto dikirim sebagai beberapa pesan.
#   comma  = kirim beberapa foto berurutan (default)
#   single = hanya foto pertama yang dilampirkan
#   none   = tanpa lampiran foto; consumer memakai tautan galeri di pesan
FONNTE_IMAGE_MODE=comma

# Jumlah foto maksimal yang dilampirkan (tiap foto = satu pesan Fonnte,
# jadi ini juga menambah biaya per pesan).
FONNTE_MAX_IMAGES=3

# Jeda antar pesan foto (detik). Menaikkan angka ini membantu kalau
# Fonnte menolak kiriman yang terlalu cepat.
FONNTE_DELAY=2

# Alamat API Fonnte. Biasanya tidak perlu diubah; berguna untuk pengujian
# dengan server tiruan.
# FONNTE_API_URL=https://api.fonnte.com/send
# FONNTE_DEVICE_URL=https://api.fonnte.com/device

# Masa berlaku tautan galeri foto (hari).
GALLERY_TTL_DAYS=90

# Tandai cookie session sebagai Secure. "auto" = mengikuti APP_ORIGIN.
COOKIE_SECURE=auto

# Jumlah koneksi database dalam pool (1-20).
DB_POOL_MAX=10

# Jumlah thread web server.
WEB_THREADS=8

# Masa berlaku sesi dalam jam.
SESSION_HOURS=8

# Batas ukuran unggahan (MB) untuk foto dan pemulihan backup.
MAX_UPLOAD_MB=9
MAX_RESTORE_MB=200
